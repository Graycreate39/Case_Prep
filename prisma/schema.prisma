generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum EvaluationSource { DETERMINISTIC AI HUMAN }
enum SessionMode { PRACTICE STRICT PRESSURE READINESS }
enum PoolRole { TRAINING TRANSFER READINESS_HOLDOUT }
enum LearningStage { NOT_INTRODUCED MODELED GUIDED INDEPENDENT TRANSFER RETAINED MASTERED }
enum SessionStatus { ACTIVE COMPLETED ABANDONED }
model User { id String @id @default(cuid()) email String @unique name String? preferences UserPreferences? skills UserSkillState[] evidence SkillEvidence[] attempts ExerciseAttempt[] sessions CaseSession[] stories BehavioralStory[] humanFeedback HumanFeedback[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model UserPreferences { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) dailyMinutes Int @default(30) targetFirmId String? interviewDate DateTime? storeAudio Boolean @default(false) }
model FirmProfile { id String @id @default(cuid()) name String version Int @default(1) controlStyle String typicalMinutes Int behavioralFormat String evaluationEmphasis Json specialFormats Json digitalAssessmentNotes String? source String lastVerifiedAt DateTime? editable Boolean @default(true) @@unique([name,version]) }
model StoryChapter { id String @id slug String @unique title String ordinal Int milestone String prerequisites Json content Json }
model StoryProgress { id String @id @default(cuid()) userId String chapterId String status String gateEvidence Json? updatedAt DateTime @updatedAt @@unique([userId,chapterId]) @@index([userId,status]) }
model Skill { id String @id label String category String importance Float @default(1) }
model UserSkillState { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) skillId String stage LearningStage @default(NOT_INTRODUCED) mastery Float uncertainty Float observations Int trend String errorTags Json lastPracticeAt DateTime? nextReviewAt DateTime? byDifficulty Json drillPerformance Float casePerformance Float updatedAt DateTime @updatedAt @@unique([userId,skillId]) @@index([userId,nextReviewAt]) }
model SkillEvidence { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) skillId String attemptId String? evidenceType String context String difficulty Int independent Boolean transferDistance Int delayed Boolean integrated Boolean score Float confidence String? guidanceLevel Int hintsUsed Int errorTag String? createdAt DateTime @default(now()) @@index([userId,skillId,evidenceType]) }
model Exercise { id String version Int kind String skillIds Json learningFunction String deepPrinciple String surfaceContext String transferDistance Int noveltyGroup String poolRole PoolRole estimatedDuration Int difficultyDimensions Json difficulty Int guidance Int prompt Json answerKey Json rationale String active Boolean @default(true) @@id([id,version]) }
model ExerciseAttempt { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) exerciseId String exerciseVersion Int answer Json score Float correct Boolean hintCount Int @default(0) attemptNumber Int independent Boolean @default(false) responseTimeMs Int? confidence String? primaryErrorTag String? transferDistance Int @default(0) errorTags Json source EvaluationSource createdAt DateTime @default(now()) skillScores AttemptSkillScore[] @@index([userId,createdAt]) }
model AttemptSkillScore { id String @id @default(cuid()) attemptId String attempt ExerciseAttempt @relation(fields:[attemptId],references:[id],onDelete:Cascade) skillId String score Int confidence Float reasoning String evidence Json improvement String source EvaluationSource @@index([attemptId,skillId]) }
model ReviewSchedule { id String @id @default(cuid()) userId String skillId String errorTag String? underlyingErrorPattern String? sourceAttemptId String? stage Int @default(0) transferContext String? intervalDays Int nextReviewAt DateTime successfulRetrievals Int @default(0) lastAttemptId String? @@index([userId,nextReviewAt]) }
model TrainingPlan { id String @id @default(cuid()) userId String durationMinutes Int algorithmVersion String createdAt DateTime @default(now()) items TrainingPlanItem[] @@index([userId,createdAt]) }
model TrainingPlanItem { id String @id @default(cuid()) planId String plan TrainingPlan @relation(fields:[planId],references:[id],onDelete:Cascade) ordinal Int activityType String targetId String targetSkillId String minutes Int rationale String @@unique([planId,ordinal]) }
model CaseSpec { id String @id title String industry String businessModel String problemFamily String versions CaseVersion[] }
model CaseVersion { id String @id @default(cuid()) caseId String case CaseSpec @relation(fields:[caseId],references:[id]) version String status String poolRole PoolRole @default(TRAINING) holdoutEligible Boolean @default(false) spec Json checksum String createdAt DateTime @default(now()) sessions CaseSession[] @@unique([caseId,version]) }
model CaseSession { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) caseVersionId String caseVersion CaseVersion @relation(fields:[caseVersionId],references:[id]) mode SessionMode status SessionStatus @default(ACTIVE) runtimeState Json specSnapshot Json unseenAtStart Boolean @default(false) firstSeenAt DateTime? seenCount Int @default(0) startedAt DateTime @default(now()) completedAt DateTime? turns CaseTurn[] evaluations CaseEvaluation[] @@index([userId,startedAt]) }
model CaseTurn { id String @id @default(cuid()) sessionId String session CaseSession @relation(fields:[sessionId],references:[id],onDelete:Cascade) ordinal Int role String visibleText String evidenceType String? createdAt DateTime @default(now()) @@unique([sessionId,ordinal]) }
model CaseEvaluation { id String @id @default(cuid()) sessionId String session CaseSession @relation(fields:[sessionId],references:[id],onDelete:Cascade) source EvaluationSource scores Json evidenceTurnIds Json confidence Float modelRunId String? createdAt DateTime @default(now()) }
model BehavioralStory { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) title String tags Json context String objective String actions String reasoning String? obstacles String? dynamics String? result String learning String alternatives Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model BehavioralSession { id String @id @default(cuid()) userId String questionIds Json turns Json evaluation Json? createdAt DateTime @default(now()) }
model HumanFeedback { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) partner String practicedAt DateTime caseName String style String evaluatorType String skillRatings Json overallFeedback String errors Json strengths Json reliabilityWeight Float createdAt DateTime @default(now()) }
model ModelRun { id String @id @default(cuid()) userId String? taskType String model String inputTokens Int? outputTokens Int? cachedTokens Int? latencyMs Int retries Int @default(0) validationFailures Int @default(0) errorCode String? createdAt DateTime @default(now()) @@index([taskType,createdAt]) }
